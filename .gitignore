# --- Your machine-specific config (commit config_example.yaml instead) ---
config.yaml
config_*.yaml
!config_example.yaml

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/

# --- Trajectory / structure data (never commit these) ---
*.xtc
*.trr
*.dcd
*.gro
*.ndx
*.pdb

# --- Generated results ---
results*/
reps_*/
*.npy
*.pkl
shared_pca_variance_summary.txt
hdbscan_output.dat

# --- Generated figures ---
# Regenerated by the scripts. Small curated examples can live in examples/.
*.png
*.svg

!examples/*.png
!examples/*.svg
!examples/*.pdb
!examples/*.gro
!examples/*.ndx

# The committed tutorial inputs and runnable configs.
!examples/protein/config.yaml
!examples/sensors/config.yaml
!examples/protein/data/*.gro
!examples/protein/data/*.ndx
!examples/protein/data/*.xtc
!examples/sensors/preview_overlay.png
